// ─────────────────────────────────────────────────────────────────────────────
// Jenkins Pipeline — Frontend CI/CD (React → S3 → CloudFront)
//
// Credentials required:
//   AWS_CREDENTIALS — AWS Access Key + Secret
// Environment variables (set at Jenkins system or pipeline level):
//   S3_BUCKET_NAME, CLOUDFRONT_DISTRIBUTION_ID, VITE_*
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent {
        kubernetes {
            defaultContainer 'node'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: node
      image: node:20-alpine
      command:
        - cat
      tty: true

    - name: aws-cli
      image: amazon/aws-cli:latest
      command:
        - sh
        - -c
        - cat
      tty: true
'''
        }
    }
    options {
    skipDefaultCheckout(true)
}

stages {
    stage('Checkout') {
        steps {
            git branch: 'main',
                url: 'https://github.com/waghvedant1990/medical-erp-3Tier.git'
        }
    }

    environment {
        AWS_REGION = 'us-east-1'
        S3_BUCKET_NAME = 'med-erp-frontend-dev-vedant-2026'
        CLOUDFRONT_DISTRIBUTION_ID = 'E18WQW39LEMKPF'
        DOMAIN_NAME = 'vwtech.shop'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                container('node') {
                    dir('frontend') {
                        sh '''
                            echo "Installing frontend dependencies..."
                            npm ci --prefer-offline
                        '''
                    }
                }
            }
        }

        stage('Lint') {
            steps {
                container('node') {
                    dir('frontend') {
                        sh '''
                            echo "Running frontend lint..."
                            npm run lint
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                container('node') {
                    dir('frontend') {
                        withEnv([
                            "VITE_USER_SERVICE_URL=https://api.${DOMAIN_NAME}/api/v1",
                            "VITE_PRODUCT_SERVICE_URL=https://api.${DOMAIN_NAME}/api/v1",
                            "VITE_ORDER_SERVICE_URL=https://api.med-erp.${DOMAIN_NAME}/api/v1"
                        ]) {
                            sh '''
                                echo "Building frontend..."
                                npm run build
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to S3') {
            when {
                branch 'main'
            }
            steps {
                container('aws-cli') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS_CREDENTIALS']
                    ]) {
                        sh '''
                            echo "Uploading frontend build to S3..."

                            aws s3 sync frontend/dist/ \
                                s3://${S3_BUCKET_NAME}/ \
                                --delete \
                                --region ${AWS_REGION}
                        '''
                    }
                }
            }
        }

        stage('CloudFront Invalidation') {
            when {
                branch 'main'
            }
            steps {
                container('aws-cli') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS_CREDENTIALS']
                    ]) {
                        sh '''
                            echo "Invalidating CloudFront cache..."

                            aws cloudfront create-invalidation \
                                --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                                --paths "/*"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully.'
        }

        failure {
            echo 'Frontend pipeline failed. Check the Jenkins console output.'
        }
    }
}
