
pipeline {
    agent {
        kubernetes {
    yaml '''

apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command: ["cat"]
    tty: true

  - name: tools
    image: alpine:3.20
    command: ["cat"]
    tty: true
    env:
    - name: DOCKER_HOST
      value: "tcp://localhost:2375"
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: docker
    image: docker:27-dind
    securityContext:
      privileged: true
    command:
    - dockerd
    args:
    - --host=tcp://0.0.0.0:2375
    - --host=unix:///var/run/docker.sock
    - --tls=false
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true

 
'''
}
    }

    environment {
        AWS_REGION    = 'us-east-1'
        AWS_ACCOUNT_ID = '259072552887'
        ECR_REGISTRY  = '259072552887.dkr.ecr.us-east-1.amazonaws.com'

        EKS_CLUSTER   = 'med-erp-dev-eks'
        K8S_NAMESPACE = 'med-erp'

        IMAGE_TAG = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
    steps {
        checkout scm

        script {
            env.IMAGE_TAG = sh(
                script: 'git rev-parse --short=8 HEAD',
                returnStdout: true
            ).trim()

            echo "Building image tag: ${env.IMAGE_TAG}"
        }

        echo "BRANCH_NAME: ${env.BRANCH_NAME}"
        echo "GIT_BRANCH: ${env.GIT_BRANCH}"
        echo "IMAGE_TAG: ${env.IMAGE_TAG}"
    }
}
        stage('Install Tools') {
    steps {
        container('tools') {
            sh '''
                apk add --no-cache \
                  docker-cli \
                  aws-cli \
                  kubectl \
                  curl

                echo "Waiting for Docker daemon..."

                for i in $(seq 1 30); do
                    if docker info >/dev/null 2>&1; then
                        echo "Docker daemon is ready!"
                        docker version
                        break
                    fi

                    echo "Waiting for Docker... ($i/30)"
                    sleep 2
                done

                docker info
                aws --version
                kubectl version --client
            '''
        }
    }
}
       
stage('Build and Test') {
    parallel {
        stage('User Service') {
            steps {
                dir('user-service') {
                    container('maven') {
                        sh '''
                            mvn -B clean verify

                            echo "User Service test reports:"
                            find target -type f -name "TEST-*.xml" || true
                        '''
                    }

                    junit(
                        testResults: '**/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Product Service') {
            steps {
                dir('product-service') {
                    container('maven') {
                        sh '''
                            mvn -B clean verify

                            echo "Product Service test reports:"
                            find target -type f -name "TEST-*.xml" || true
                        '''
                    }

                    junit(
                        testResults: '**/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Order Service') {
            steps {
                dir('order-service') {
                    container('maven') {
                        sh '''
                            mvn -B clean verify

                            echo "Order Service test reports:"
                            find target -type f -name "TEST-*.xml" || true
                        '''
                    }

                    junit(
                        testResults: '**/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }
    }
}


           
stage('SonarCloud Analysis') {
    when {
        branch 'main'
    }

    steps {
        withCredentials([
            string(
                credentialsId: 'SONARCLOUD_TOKEN',
                variable: 'SONAR_TOKEN'
            )
        ]) {
            container('maven') {
                sh """
                    mvn sonar:sonar \
                      -Dsonar.projectKey=waghvedant1990_medical-erp-3Tier \
                      -Dsonar.organization=waghvedant1990 \
                      -Dsonar.host.url=https://sonarcloud.io \
                      -Dsonar.token=\$SONAR_TOKEN \
                      -Dsonar.qualitygate.wait=true \
                      -B
                """
            }
        }
    }
}

        stage('Docker Build and Push') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('tools') {
                        script {
                            sh '''
                                echo "Waiting for Docker daemon..."

                                for i in $(seq 1 30); do
                                  if docker info >/dev/null 2>&1; then
                                    break
                                  fi
                                  sleep 2
                                done

                                docker info

                                aws ecr get-login-password \
                                  --region "$AWS_REGION" |
                                docker login \
                                  --username AWS \
                                  --password-stdin "$ECR_REGISTRY"
                            '''

                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                def imageName =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:${env.IMAGE_TAG}"

                                def latestImage =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:latest"

                                sh """
                                    docker build \
                                      -t ${imageName} \
                                      -t ${latestImage} \
                                      ${svc}/

                                    docker push ${imageName}
                                    docker push ${latestImage}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('trivy') {
                        script {
                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                sh """
                                    trivy image \
                                      --scanners vuln \
                                      --exit-code 1 \
                                      --severity HIGH,CRITICAL \
                                      --no-progress \
                                      ${env.ECR_REGISTRY}/med-erp/${svc}:${env.IMAGE_TAG}
                                """
                            }
                        }
                    }
                }
            }
        }

        
stage('Deploy to EKS') {
    steps {
        container('tools') {
            script {
                if (!env.IMAGE_TAG?.trim()) {
                    error("IMAGE_TAG is missing")
                }

                sh """
                    aws eks update-kubeconfig \
                      --region ${AWS_REGION} \
                      --name ${EKS_CLUSTER}

                    kubectl apply -f k8s/ -n ${K8S_NAMESPACE}

                    kubectl set image deployment/user-service \
                      user-service=${ECR_REGISTRY}/med-erp/user-service:${IMAGE_TAG} \
                      -n ${K8S_NAMESPACE}

                    kubectl set image deployment/product-service \
                      product-service=${ECR_REGISTRY}/med-erp/product-service:${IMAGE_TAG} \
                      -n ${K8S_NAMESPACE}

                    kubectl set image deployment/order-service \
                      order-service=${ECR_REGISTRY}/med-erp/order-service:${IMAGE_TAG} \
                      -n ${K8S_NAMESPACE}

                    kubectl rollout status deployment/user-service \
                      -n ${K8S_NAMESPACE} --timeout=300s

                    kubectl rollout status deployment/product-service \
                      -n ${K8S_NAMESPACE} --timeout=300s

                    kubectl rollout status deployment/order-service \
                      -n ${K8S_NAMESPACE} --timeout=300s
                """
            }
        }
    }
}
    }
}

    }

    
post {
    success {
        echo "CI/CD Pipeline completed successfully!"
        echo "Docker Image Tag: ${env.IMAGE_TAG}"
    }

    failure {
        echo "CI/CD Pipeline failed. Check Jenkins console logs."
    }

    always {
        cleanWs()
    }
}

}
