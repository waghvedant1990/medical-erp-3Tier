
pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command: ["cat"]
    tty: true
    volumeMounts:
    - name: maven-cache
      mountPath: /root/.m2

  - name: tools
    image: alpine:3.20
    command: ["cat"]
    tty: true
    env:
    - name: DOCKER_HOST
      value: "tcp://localhost:2375"
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: docker
    image: docker:27-dind
    securityContext:
      privileged: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true

  volumes:
  - name: maven-cache
    persistentVolumeClaim:
      claimName: maven-cache-pvc
'''
        }
    }

    environment {
        AWS_REGION    = 'us-east-1'
        AWS_ACCOUNT_ID = '259072552887'
        ECR_REGISTRY  = '259072552887.dkr.ecr.us-east-1.amazonaws.com'

        EKS_CLUSTER   = 'med-erp-prod-eks'
        K8S_NAMESPACE = 'med-erp'

        IMAGE_TAG = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Building image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Install Tools') {
            steps {
                container('tools') {
                    sh '''
                        apk add --no-cache \
                          docker-cli \
                          aws-cli \
                          kubectl \
                          curl
                    '''

                    sh 'docker version'
                    sh 'aws --version'
                    sh 'kubectl version --client'
                }
            }
        }

        stage('Build and Test') {
            parallel {

                stage('User Service') {
                    steps {
                        container('maven') {
                            dir('user-service') {
                                sh 'mvn clean verify -B'
                                junit 'target/surefire-reports/*.xml'
                            }
                        }
                    }
                }

                stage('Product Service') {
                    steps {
                        container('maven') {
                            dir('product-service') {
                                sh 'mvn clean verify -B'
                                junit 'target/surefire-reports/*.xml'
                            }
                        }
                    }
                }

                stage('Order Service') {
                    steps {
                        container('maven') {
                            dir('order-service') {
                                sh 'mvn clean verify -B'
                                junit 'target/surefire-reports/*.xml'
                            }
                        }
                    }
                }
            }
        }

           
stage('SonarCloud Analysis') {
    when {
        branch 'main'
    }

    steps {
        withCredentials([
            string(
                credentialsId: 'SONARCLOUD_TOKEN',
                variable: 'SONAR_TOKEN'
            )
        ]) {
            container('maven') {
                sh """
                    mvn sonar:sonar \
                      -Dsonar.projectKey=waghvedant1990_medical-erp-3Tier \
                      -Dsonar.organization=waghvedant1990 \
                      -Dsonar.host.url=https://sonarcloud.io \
                      -Dsonar.token=\$SONAR_TOKEN \
                      -Dsonar.qualitygate.wait=true \
                      -B
                """
            }
        }
    }
}

        stage('Docker Build and Push') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('tools') {
                        script {
                            sh '''
                                echo "Waiting for Docker daemon..."

                                for i in $(seq 1 30); do
                                  if docker info >/dev/null 2>&1; then
                                    break
                                  fi
                                  sleep 2
                                done

                                docker info

                                aws ecr get-login-password \
                                  --region "$AWS_REGION" |
                                docker login \
                                  --username AWS \
                                  --password-stdin "$ECR_REGISTRY"
                            '''

                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                def imageName =
                                    "${ECR_REGISTRY}/med-erp/${svc}:${IMAGE_TAG}"

                                def latestImage =
                                    "${ECR_REGISTRY}/med-erp/${svc}:latest"

                                sh """
                                    docker build \
                                      -t ${imageName} \
                                      -t ${latestImage} \
                                      ${svc}/

                                    docker push ${imageName}
                                    docker push ${latestImage}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('trivy') {
                        script {
                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                sh """
                                    trivy image \
                                      --scanners vuln \
                                      --exit-code 1 \
                                      --severity HIGH,CRITICAL \
                                      --no-progress \
                                      ${ECR_REGISTRY}/med-erp/${svc}:${IMAGE_TAG}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to EKS') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('tools') {
                        script {
                            sh """
                                aws eks update-kubeconfig \
                                  --region ${AWS_REGION} \
                                  --name ${EKS_CLUSTER}
                            """

                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                sh """
                                    kubectl set image \
                                      deployment/${svc} \
                                      ${svc}=${ECR_REGISTRY}/med-erp/${svc}:${IMAGE_TAG} \
                                      -n ${K8S_NAMESPACE}

                                    kubectl rollout status \
                                      deployment/${svc} \
                                      -n ${K8S_NAMESPACE} \
                                      --timeout=300s
                                """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CI/CD Pipeline completed successfully!"
            echo "Docker Image Tag: ${IMAGE_TAG}"
        }

        failure {
            echo "CI/CD Pipeline failed. Check Jenkins console logs."
        }

        always {
            cleanWs()
        }
    }
}
