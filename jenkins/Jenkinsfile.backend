
pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9-eclipse-temurin-17
    command: ["cat"]
    tty: true

  - name: tools
    image: alpine:3.20
    command: ["cat"]
    tty: true
    env:
    - name: DOCKER_HOST
      value: "tcp://localhost:2375"
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: docker
    image: docker:27-dind
    securityContext:
      privileged: true
    command:
    - dockerd
    args:
    - --host=tcp://0.0.0.0:2375
    - --host=unix:///var/run/docker.sock
    - --tls=false
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""

  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true

  - name: sonar
    image: sonarsource/sonar-scanner-cli:latest
    command: ["cat"]
    tty: true
'''
        }
    }

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '259072552887'
        ECR_REGISTRY   = '259072552887.dkr.ecr.us-east-1.amazonaws.com'

        EKS_CLUSTER    = 'med-erp-dev-eks'
        K8S_NAMESPACE  = 'med-erp'

        IMAGE_TAG = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        // -----------------------------------------
        // 1. CHECKOUT
        // -----------------------------------------

        

stage('Checkout') {
    steps {
        checkout scm

        script {
            env.IMAGE_TAG = sh(
                script: 'git rev-parse --short=8 HEAD',
                returnStdout: true
            ).trim()

            if (!env.IMAGE_TAG || env.IMAGE_TAG == 'null') {
                error('Unable to generate Docker image tag from Git commit')
            }

            echo "Git commit: ${sh(script: 'git rev-parse HEAD', returnStdout: true).trim()}"
            echo "Docker image tag: ${env.IMAGE_TAG}"
        }
    }
}


        // -----------------------------------------
        // 2. INSTALL TOOLS
        // -----------------------------------------

        stage('Install Tools') {
            steps {
                container('tools') {
                    sh '''
                        apk add --no-cache \
                          docker-cli \
                          aws-cli \
                          kubectl \
                          curl

                        echo "Waiting for Docker daemon..."

                        for i in $(seq 1 30); do
                            if docker info >/dev/null 2>&1; then
                                echo "Docker daemon is ready"
                                break
                            fi

                            echo "Waiting for Docker ($i/30)"
                            sleep 2
                        done

                        docker info
                        aws --version
                        kubectl version --client
                    '''
                }
            }
        }

        // -----------------------------------------
        // 3. MAVEN BUILD AND TEST
        // -----------------------------------------

        stage('Build and Test') {
            parallel {

                stage('User Service') {
                    steps {
                        dir('user-service') {
                            container('maven') {
                                sh 'mvn -B clean verify'
                            }

                            junit(
                                testResults: 'target/surefire-reports/TEST-*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                stage('Product Service') {
                    steps {
                        dir('product-service') {
                            container('maven') {
                                sh 'mvn -B clean verify'
                            }

                            junit(
                                testResults: 'target/surefire-reports/TEST-*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                stage('Order Service') {
                    steps {
                        dir('order-service') {
                            container('maven') {
                                sh 'mvn -B clean verify'
                            }

                            junit(
                                testResults: 'target/surefire-reports/TEST-*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }
            }
        }

        // -----------------------------------------
        // 4. SONARCLOUD ANALYSIS
        // -----------------------------------------

        stage('SonarCloud Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'SONARCLOUD_TOKEN',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    container('sonar') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=waghvedant1990_medical-erp-3Tier \
                              -Dsonar.organization=waghvedant1990 \
                              -Dsonar.host.url=https://sonarcloud.io \
                              -Dsonar.sources=user-service/src/main,product-service/src/main,order-service/src/main \
                              -Dsonar.tests=user-service/src/test,product-service/src/test,order-service/src/test \
                              -Dsonar.java.binaries=user-service/target/classes,product-service/target/classes,order-service/target/classes \
                              -Dsonar.token="$SONAR_TOKEN" \
                              -Dsonar.qualitygate.wait=false
                        '''
                    }
                }
            }
        }

        // -----------------------------------------
        // 5. DOCKER BUILD AND PUSH TO ECR
        // -----------------------------------------

        stage('Docker Build and Push') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('tools') {
                        script {
                            sh '''
                                aws ecr get-login-password \
                                  --region "$AWS_REGION" |
                                docker login \
                                  --username AWS \
                                  --password-stdin "$ECR_REGISTRY"
                            '''

                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                def imageName =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:${env.IMAGE_TAG}"

                                def latestImage =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:latest"

                                echo "Building ${imageName}"

                                sh """
                                    docker build \
                                      -t ${imageName} \
                                      -t ${latestImage} \
                                      ${svc}/

                                    docker push ${imageName}
                                    docker push ${latestImage}
                                """
                            }
                        }
                    }
                }
            }
        }

        // -----------------------------------------
        // 6. TRIVY SECURITY SCAN
        // -----------------------------------------

        stage('Trivy Security Scan') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('trivy') {
                        script {
                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                def imageName =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:${env.IMAGE_TAG}"

                                echo "Scanning ${imageName}"

                                sh """
                                    trivy image \
                                      --scanners vuln \
                                      --exit-code 1 \
                                      --severity HIGH,CRITICAL \
                                      --no-progress \
                                      ${imageName}
                                """
                            }
                        }
                    }
                }
            }
        }

        // -----------------------------------------
        // 7. DEPLOY TO EKS
        // -----------------------------------------

        stage('Deploy to EKS') {
            steps {
                script {
                    if (!env.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is missing. Deployment stopped.')
                    }
                }

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'AWS_CREDENTIALS',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    container('tools') {
                        sh '''
                            echo "Connecting to EKS..."

                            aws eks update-kubeconfig \
                              --region "$AWS_REGION" \
                              --name "$EKS_CLUSTER"

                            echo "Applying Kubernetes manifests..."

                            kubectl apply -R -f k8s/ \
                              -n "$K8S_NAMESPACE"
                        '''

                        script {
                            def services = [
                                'user-service',
                                'product-service',
                                'order-service'
                            ]

                            services.each { svc ->

                                def imageName =
                                    "${env.ECR_REGISTRY}/med-erp/${svc}:${env.IMAGE_TAG}"

                                echo "Deploying ${imageName}"

                                sh """
                                    kubectl set image \
                                      deployment/${svc} \
                                      ${svc}=${imageName} \
                                      -n ${env.K8S_NAMESPACE}

                                    kubectl rollout status \
                                      deployment/${svc} \
                                      -n ${env.K8S_NAMESPACE} \
                                      --timeout=300s
                                """
                            }
                        }

                        sh '''
                            echo "Deployment verification"

                            kubectl get deployments -n "$K8S_NAMESPACE"
                            kubectl get pods -n "$K8S_NAMESPACE"
                            kubectl get services -n "$K8S_NAMESPACE"
                        '''
                    }
                }
            }
        }
    }

    // -----------------------------------------
    // POST BUILD ACTIONS
    // -----------------------------------------

    post {
        success {
            echo 'Medical ERP CI/CD completed successfully!'
            echo "Docker Image Tag: ${env.IMAGE_TAG}"
        }

        failure {
            echo 'Medical ERP CI/CD pipeline failed.'
            echo 'Check the failed stage in Jenkins console output.'
        }

        always {
            cleanWs()
        }
    }
}
